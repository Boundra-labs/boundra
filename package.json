{
  "name": "boundra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "env:setup": "node scripts/setup.mjs",
    "dev": "pnpm build:packages && pnpm --parallel --filter @boundra/web --filter @boundra/api --filter @boundra/worker dev",
    "build:packages": "pnpm --filter @boundra/shared --filter @boundra/database --filter @boundra/chain --filter @boundra/acce --filter @boundra/llm --filter @boundra/sdk build",
    "build": "pnpm build:packages && pnpm --filter @boundra/web --filter @boundra/api --filter @boundra/worker build",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real-api.config.ts",
    "test:e2e:chain": "pnpm --workspace-concurrency=1 --filter @boundra/worker --filter @boundra/sdk test:e2e:chain",
    "benchmark": "pnpm build:packages && pnpm --filter @boundra/evaluation build && pnpm --filter @boundra/evaluation benchmark",
    "contracts:build": "pnpm --filter @boundra/contracts build",
    "contracts:test": "pnpm --filter @boundra/contracts test",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @boundra/database db:generate",
    "db:migrate": "pnpm --filter @boundra/database db:migrate",
    "db:backup": "docker compose run --rm backup once",
    "db:restore-drill": "node scripts/restore-drill.mjs",
    "db:studio": "pnpm --filter @boundra/database db:studio",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "viem": "2.57.7"
  }
}
