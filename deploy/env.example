# Settings for the Docker deployment (compose.yaml, `app` and `public` profiles).
# Create deploy/.env from this file with `node scripts/setup.mjs --deploy`, which fills in fresh
# secrets, then run every Compose command with `--env-file deploy/.env`. Values here are seen
# from inside the containers, so they differ from the host-run development .env.
# deploy/.env holds secrets: keep it out of git (ignored) and readable by the operator only.

# --- Release ---------------------------------------------------------------------------------
# Tags the images and is reported by /status and /api/v1/health/*. Use `git describe --always`.
RELEASE=dev
# Image names: ${IMAGE_PREFIX}-web:${RELEASE} etc. Keep "boundra" for images built here; use
# ghcr.io/<owner>/boundra to run images published by the release workflow.
IMAGE_PREFIX=boundra

# --- Database (internal to the Docker network) -----------------------------------------------
POSTGRES_USER=boundra
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=boundra
POSTGRES_PORT=55432

# --- Web origin and HTTPS --------------------------------------------------------------------
# Public profile: APP_DOMAIN=boundra.example.org, WEB_ORIGIN=https://boundra.example.org and
# TRUST_PROXY=true (the proxy sets X-Forwarded-For). Without the proxy keep the defaults below.
APP_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
SESSION_SECRET=

# --- Chain -----------------------------------------------------------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# A reviewed manifest from deploy/manifests, as seen in the container. Empty = observe-only.
DEPLOYMENT_MANIFEST_PATH=
CHAIN_CONFIRMATIONS=5
# Public operator address the API shows owners in mandates (never the key).
OPERATOR_ADDRESS=
# Wallets allowed to use /admin endpoints (comma-separated, lowercase).
ADMIN_ADDRESSES=

# --- Agent execution (worker) ----------------------------------------------------------------
# Stays monitor-only until EXECUTION_ENABLED=true and every value below is set.
# The operator key must never equal the risk admin or deployer key.
EXECUTION_ENABLED=false
OPERATOR_PRIVATE_KEY=
ATTEMPT_ENCRYPTION_KEY=
MAX_GAS=
MAX_FEE_PER_GAS_WEI=
MAX_PRIORITY_FEE_PER_GAS_WEI=
ACTION_DEADLINE_SECONDS=300

# --- Language model (API) --------------------------------------------------------------------
# disabled = reviewed templates only. A real run needs anthropic or openai plus a runtime key;
# openai also needs LLM_MODEL (for example gpt-4.1-mini).
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=

# --- Backups ---------------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=28
