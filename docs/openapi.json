                "properties": {
                  "expiryDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 60
                  },
                  "maxDepositPerAction": {
                    "type": "string"
                  },
                  "maxWithdrawPerAction": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "__Host-boundra_session": []
          }
        ],
        "summary": "Draft a mandate revision with its structured preview",
