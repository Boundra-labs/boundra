    "/api/v1/mandate-drafts/{id}/approve": {
      "post": {
        "operationId": "MandatesController_approve",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Required for POST/PATCH requests",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "previewHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  }
                },
                "required": ["previewHash"],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "__Host-boundra_session": []
          }
        ],
        "summary": "Approve the exact previewed revision; returns the owner transactions to send",
        "tags": ["mandates"]
      }
    },
