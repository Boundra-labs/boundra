  "info": {
    "title": "Boundra API",
    "description": "Base Sepolia testnet prototype. Session cookie auth via SIWE; state-changing requests need X-CSRF-Token and an allowed Origin. Amounts are base-unit strings.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-boundra_session"
      }
    },
    "schemas": {}
