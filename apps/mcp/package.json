{
  "name": "@boundra/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that lets AI assistants read an owner's Boundra agent, prepare mandates and owner actions, and act as a bounded operator (Base Sepolia testnet only).",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "boundra-mcp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@boundra/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@boundra/chain": "workspace:*",
    "vitest": "5.0.4"
  }
}
