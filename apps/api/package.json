    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15"
  }
