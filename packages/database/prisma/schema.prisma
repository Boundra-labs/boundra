generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkflowState {
  INTENT_RECEIVED
  CLARIFYING
  MANDATE_PENDING
  AUTHORIZED
  ACTION_PROPOSED
  POLICY_CHECKED
  BROADCAST
  CONFIRMED
  REJECTED
  FAILED
  RECONCILE
  ESCALATED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model WalletIdentity {
  id           String         @id @default(uuid()) @db.Uuid
  address      String         @unique @db.VarChar(42)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  intents      Intent[]
  authSessions AuthSession[]
}

model AuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  nonceHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model AuthSession {
  id          String         @id @default(uuid()) @db.Uuid
  tokenHash   String         @unique @db.VarChar(64)
  ownerId     String         @db.Uuid
  owner       WalletIdentity @relation(fields: [ownerId], references: [id])
  expiresAt   DateTime       @db.Timestamptz(3)
  revokedAt   DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([ownerId, expiresAt])
}

model Intent {
  id          String         @id @default(uuid()) @db.Uuid
  ownerId     String         @db.Uuid
  owner       WalletIdentity @relation(fields: [ownerId], references: [id])
  objective   String         @db.VarChar(2000)
  amount      Decimal        @db.Decimal(78, 0)
  chainId     Int            @default(84532)
  state       WorkflowState  @default(INTENT_RECEIVED)
  preferences Json           @default("{}")
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  @@index([ownerId, createdAt])
}

// Durable job envelope only. Claim/lease processing is Person 2's next task.
model Job {
  id         String    @id @default(uuid()) @db.Uuid
  key        String    @unique @db.VarChar(200)
  kind       String    @db.VarChar(100)
  payload    Json
  status     JobStatus @default(PENDING)
  attempts   Int       @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil DateTime? @db.Timestamptz(3)
  leaseOwner String?   @db.VarChar(100)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([status, leaseUntil])
}

model WorkerHeartbeat {
  id        String   @id @db.VarChar(100)
  mode      String   @db.VarChar(32)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
