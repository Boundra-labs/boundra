# Local development only. setup generates a unique local database password.
NODE_ENV=development
POSTGRES_USER=boundra
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=boundra
POSTGRES_PORT=55432
DATABASE_URL=postgresql://boundra:replace-with-a-local-password@localhost:55432/boundra?schema=public
API_PORT=3001
API_HOST=127.0.0.1
API_INTERNAL_URL=http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:3000
CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
WORKER_POLL_INTERVAL_MS=10000
WORKER_HEARTBEAT_MAX_AGE_MS=45000
OBSERVATION_MAX_AGE_MS=30000
CHAIN_CONFIRMATIONS=5
# Signing remains disabled in the scaffold. Never add NEXT_PUBLIC_ to a secret.
OPERATOR_PRIVATE_KEY=
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
